{
    "name": "@irs-buddy/webapp",
    "version": "1.0.0",
    "exports": {},
    "tasks": {
        "dev": "deno run -A --watch main.ts '--port=${PORT:-4200}'",
        "build": "deno run -A build.ts",
        "cache": "deno cache --reload main.ts",
        "outdated": "deno outdated --update"
    },
    "imports": {
        "@std/http-file-server": "jsr:@std/http/file-server"
    },
    "fmt": {
        "include": [
            "src/",
            "main.ts"
        ],
        "exclude": [
            "dist/"
        ],
        "singleQuote": true
    },
    "lint": {
        "include": [
            "src/",
            "main.ts"
        ],
        "exclude": [
            "dist/"
        ]
    }
}